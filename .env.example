# ==============================================================================
# SIVARSTOCK - VARIABLES DE ENTORNO (POSTGRESQL / SUPABASE / VERCEL / LOOKER STUDIO)
# ==============================================================================

# Configuración Empresarial (Guatemala)
NEXT_PUBLIC_APP_NAME="SivarStock"
NEXT_PUBLIC_COMPANY_NAME="SivarStock Manufactura S.A. (Guatemala)"
NEXT_PUBLIC_DEFAULT_CURRENCY="GTQ"
NEXT_PUBLIC_CURRENCY_SYMBOL="Q"
NEXT_PUBLIC_TIMEZONE="America/Guatemala"
APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# CONEXIÓN A POSTGRESQL / SUPABASE (PRODUCCIÓN & LOOKER STUDIO)
# ------------------------------------------------------------------------------
# Cadena de conexión directa a PostgreSQL (Transaction pooler puerto 6543 o Directo 5432)
# Obtener en Supabase -> Project Settings -> Database -> Connection String (URI)
DATABASE_URL="postgres://postgres.[YOUR_PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Credenciales de API Supabase
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR_PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# ------------------------------------------------------------------------------
# PARÁMETROS PARA CONECTOR DE GOOGLE LOOKER STUDIO (DATA STUDIO)
# ------------------------------------------------------------------------------
# En Looker Studio -> Agregar datos -> Conector PostgreSQL:
# Host: aws-0-[REGION].pooler.supabase.com (o el host directo de tu proyecto)
# Puerto: 5432 (o 6543)
# Base de datos: postgres
# Usuario: postgres.[YOUR_PROJECT_REF]
# Contraseña: [TU_PASSWORD_DE_SUPABASE]
# Habilitar SSL: Activado
# Vistas recomendadas para tablas y gráficos:
# - vw_gds_inventory_assets
# - vw_gds_cost_analytics
# - vw_gds_consumables_stock
# - vw_gds_digital_services
# - vw_gds_kardex_movements
# - vw_gds_assignments_history

# ------------------------------------------------------------------------------
# MODO LOCAL / PRUEBAS DESCONECTADAS (FALLBACK)
# Si DATABASE_URL no está definida, el sistema usa SQLite (sql.js) en esta ruta:
DATABASE_PATH="./data/sivarstock.db"

# Seguridad y Sesiones
SESSION_SECRET="sivarstock_enterprise_auth_secret_key_change_me_2026"
DEMO_MODE="true"
